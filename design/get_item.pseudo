# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

    # Information needed
    # current_room, room_item (item in current_room, if any) and inventory

    Prompt and receive get-item command

    OUTPUT "Enter your command:"
    INPUT command_text
    PARSE command_text INTO action AND requested_item

    Validate whether the requested_item is in current_room
    IF action IS "get" AND requested_item IS room_item AND room_item IS NOT empty THEN

    # Valid item request
        ADD requested_item TO inventory
        SET room_item TO empty
        OUTPUT requested_item + "retrieved!" 
    ELSE

    # Invalid item request
        OUTPUT "Can't get the " + requested_item + "!"
    END IF

    # Return to or continue the main game loop
    OUTPUT "Current inventory: " + inventory
    # Control returns to main WHILE loop for next player command

END get_item


