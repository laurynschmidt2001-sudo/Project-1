# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7
#
# Review the course-provided movement flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

 SET current_room TO 'Mousehole'
 SET inventory TO empty list
  SET game_over TO FALSE

 WHILE game_over IS FALSE
    OUTPUT current_room
    OUTPUT available directions / room details
    INPUT command_text

# Movement command
(expected format: "go North","go South","go East","go West")
    SPLIT command_text INTO words
    IF length of words is 2 AND words[0] IS "go" THEN
        SET direction TO formatted words[1] (e.g., "North", "South", "East", "West")

        IF direction is A VALID EXIT FROM current_room THEN
            SET current_room TO room connected to current_room in direction
                OUTPUT "You move" + direction + "to the" + current_room + "."

                # Check ending conditions
                IF current_room IS "Sunroom" THEN
                    IF inventory has all 6 distraction items THEN 
                        OUTPUT "You distract Mr.Kitty and escape outside!"
                            SET game_over TO TRUE
                        ELSE 
                            OUTPUT "Mr.Kitty spots you before you have all six items! Game over."
                            SET game_over TO TRUE
                        END IF
                    END IF
                ELSE
                    OUTPUT "You can't go that way!"
                END IF 
            ELSE
                OUTPUT "Invalid Input! Use commands like 'go North', 'go South', 'go East', 'go West'."
            END IF
        END WHILE 






